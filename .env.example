# Application Settings
PAYLOAD_SECRET=your-random-payload-secret-at-least-32-chars
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URI=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Neon S3-Compatible Object Storage
AWS_ENDPOINT_URL_S3=https://br-late-resonance-az7q366p.storage.c-3.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=your-neon-access-key-id
AWS_SECRET_ACCESS_KEY=your-neon-secret-access-key
AWS_REGION=ap-southeast-1
S3_BUCKET=assets
