# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# IDEs and editors
/.idea
/.vscode
.project
.classpath
.c9/
*.launch
.history/*
.settings/
*.sublime-workspace

# env files (can opt-in for committing if needed)
.env*
!.env.example

# databases & local data
*.db
*.db-journal
*.sqlite
*.sqlite3

# secrets, keys & credentials
*.pem
*.key
*.cert
*.crt
*credential*
credentials.*

# vercel & hosting
.vercel
.neon

# typescript
*.tsbuildinfo
next-env.d.ts
.DS_Store
report.html
report.json
