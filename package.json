{
  "name": "rekasandi-portfolio",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src payload.config.ts",
    "payload:migrate": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/scripts/database.ts",
    "payload:seed": "node --env-file=.env node_modules/payload/bin.js run src/scripts/seed-payload.ts",
    "payload:verify": "node --env-file=.env node_modules/tsx/dist/cli.mjs src/scripts/database.ts verify",
    "payload:db-init": "npm run payload:migrate && npm run payload:seed && npm run payload:verify",
    "check:publishing": "node --env-file=.env node_modules/payload/bin.js run src/scripts/check-publishing.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
