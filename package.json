    "@payloadcms/plugin-seo": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
